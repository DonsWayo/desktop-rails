source "https://rubygems.org"

# A deliberately small Rails app standing in for a hosted production server in
# .github/workflows/hosted-app.yml. It is also where the hosted package is
# built from, the way a real app's repository would run
# `bin/rails desktop:package:hosted`.
gem "rails", "~> 8.1.3", ">= 8.1.3.1"
gem "puma", ">= 5.0"

gem "desktop-rails", path: "../../desktop-rails"

# See examples/notes/Gemfile: json 3 breaks ActiveSupport::JSON.decode.
gem "json", "< 3"
