#!/usr/bin/env ruby
# frozen_string_literal: true

# Boot Puma from config.ru on a port the OS picks, and write one line of
# handshake where the shell can read it.
#
# Generated by `rails generate turbo_desktop:install` from the same template the
# packagers install into a bundle. It is deliberately the same script in both
# places: `rails desktop:run` runs this, a packaged .app runs this, and a bug
# that only appears in one of them would be a bug nobody could reproduce.
#
# Never `rails server`. railties creates tmp/cache, tmp/pids and tmp/sockets
# under Rails.root ignoring config.paths, which is EACCES in a read-only bundle.
require "json"
require "rack"
require "puma"
require "puma/configuration"
require "puma/launcher"

# This script is run both from bin/ and from the application root, depending on
# whether a packager copied it up, so the root is found rather than assumed.
APP_ROOT = [ __dir__, File.expand_path("..", __dir__) ]
  .find { |dir| File.exist?(File.join(dir, "config.ru")) } ||
  abort("[boot] no config.ru above #{__dir__} — this is not a Rails application")

# The environment the app was built for, when it has one. The launcher exports
# RAILS_ENV=production as a safe default for a bundle with no desktop
# environment; when the install generator has written one, that is the
# environment to boot. TURBO_DESKTOP_ENV overrides both.
if (env = ENV["TURBO_DESKTOP_ENV"])
  ENV["RAILS_ENV"] = env
elsif File.exist?(File.join(APP_ROOT, "config", "environments", "desktop.rb"))
  ENV["RAILS_ENV"] = "desktop"
end

# Keep a private handle on the real stdout, then point $stdout at stderr.
# Everything Puma prints — the banner especially — goes to stderr, and the
# handshake channel stays clean. Doing it here rather than through Puma's
# log_writer keeps this independent of Puma's API, which has moved around.
handshake = $stdout.dup
handshake.sync = true
$stdout.reopen($stderr)

Dir.chdir(APP_ROOT)
app, _ = Rack::Builder.parse_file(File.join(APP_ROOT, "config.ru"))

config = Puma::Configuration.new do |c|
  c.bind "tcp://127.0.0.1:0"     # the OS picks, which removes the pick-a-port race
  c.app app
  c.workers 0                    # one process to supervise, and one to reap
  c.threads 1, 5
  c.log_requests false
end

launcher = Puma::Launcher.new(config)

# Puma 8 renamed on_booted to after_booted, and the bound port comes from
# binder.connected_ports — binder.full_urls does not exist. An exception raised
# in this hook is swallowed by Puma's event loop, so it is reported explicitly
# rather than leaving a server running that never announced itself.
hook = launcher.events.respond_to?(:after_booted) ? :after_booted : :on_booted
launcher.events.public_send(hook) do
  begin
    port = launcher.binder.connected_ports.first
    raise "Puma bound no TCP port" unless port

    handshake.puts JSON.generate(protocol: "1.0", url: "http://127.0.0.1:#{port}", pid: Process.pid)
  rescue => e
    warn "[boot] could not announce the server: #{e.class}: #{e.message}"
    Process.exit!(1)
  end
end

# The rule that prevents an orphaned server: exit when the parent closes stdin.
# It is the only layer that survives the parent being force-quit, since no shell
# code runs then. Skipped when stdin is a terminal, so the script stays runnable
# by hand for debugging.
if $stdin.stat.pipe? || !$stdin.tty?
  Thread.new do
    $stdin.read
    Process.exit!(0)
  end
end

launcher.run
